{
  "name": "ramsgate-reborn-launcher",
  "description": "Ramsgate Reborn launcher: sign in, verify your install, and play Dauntless",
  "author": "Ramsgate Reborn",
  "private": true,
  "version": "0.2.46",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:offline": "node --test \"src/offline/*.test.ts\"",
    "test:ui": "node --test \"src/offline/*.test.ts\" \"src/launch/*.test.ts\" \"src/ui/*.test.ts\" \"src/lib/*.test.ts\""
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.2.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
