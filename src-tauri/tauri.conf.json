{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ramsgate Reborn",
  "mainBinaryName": "launcher",
  "version": "0.2.50",
  "identifier": "dev.ramsgatereborn.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ramsgate Reborn Launcher",
        "width": 1120,
        "height": 700,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 http://127.0.0.1:3000; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'",
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "ramsgatereborn"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwQURDNTgzMDhCREFFQUQKUldTdHJyMElnOFd0TUJGeVQyTHJQUitKSFo5QW5PU3lrZGVZR0RVOGgzdXdSNmJCcStudnlVQWEK",
      "endpoints": [],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "resources": {
      "../../scripts/offline/offline-stack.ps1": "offline/offline-stack.ps1",
      "../../scripts/offline/install-offline.ps1": "offline/install-offline.ps1",
      "../../scripts/offline/verify-component.ps1": "offline/verify-component.ps1",
      "offline-component": "offline-component"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp"
      }
    }
  }
}